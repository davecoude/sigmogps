# ───────── Backend (FastAPI) ─────────
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Base de datos (Neon)
DATABASE_URL=postgresql+psycopg://usuario:clave@host/basedatos?sslmode=require

# Sesión
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=none
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin inicial (lo consume el script de seed — RF-07)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wialon
WIALON_HOST=
WIALON_TOKEN=
WIALON_TIMEOUT_SECONDS=10
WIALON_CACHE_TTL_SECONDS=15

# Umbrales del estado derivado (sección 4.4)
VEHICLE_STALE_MINUTES=10
VEHICLE_MOVING_MIN_KMH=3

# Límite de intentos de ingreso (SEG-07)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Limitador de peticiones por IP (SEG-06)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10

# ───────── Frontend (Nuxt) ─────────
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
